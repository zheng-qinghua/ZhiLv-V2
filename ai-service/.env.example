# ===== ai-service 配置 =====
# D15 骨架阶段用不到下面的 LLM 配置;D16 接入 DeepSeek 前把本文件复制成 .env 并填好

# 服务端口
SERVICE_PORT=8100

# ---- 大模型(OpenAI 兼容接口)----
# 模型名固定用 deepseek-v4-flash
LLM_MODEL=deepseek-v4-flash
# API key:由你填写
LLM_API_KEY=
# 接口地址:官方或你的中转渠道,由你填写
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# ---- 调 Java 内部接口(/internal/**)的共享密钥 ----
# 必须与后端 app.ai.service-key 的值完全一致(后端那边由环境变量 AI_SERVICE_KEY 注入)。
# 两边不一致 → /internal/weather 回 401,天气专家答不出天气。
AI_SERVICE_KEY=

# ---- 向量化(RAG 检索用,SiliconFlow / OpenAI 兼容 embeddings)----
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ---- MySQL(RAG 召回按 chunk_id 取原文;不是业务库写入)----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zhilv
MYSQL_USER=root
MYSQL_PASSWORD=

# ---- Milvus(只存向量 + chunk_id)----
# 注意变量名不能叫 MILVUS_URI,会与 pymilvus 保留变量撞名
RAG_MILVUS_URI=http://localhost:19530
RAG_DATA_DIR=data/rag
RAG_TOP_K=4
