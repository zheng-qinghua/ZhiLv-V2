# ===== ai-service 配置 =====
# D15 骨架阶段用不到下面的 LLM 配置;D16 接入 DeepSeek 前把本文件复制成 .env 并填好

# 服务端口
SERVICE_PORT=8100

# ---- 大模型(OpenAI 兼容接口)----
# 模型名固定用 deepseek-v4-flash
LLM_MODEL=deepseek-v4-flash
# API key:由你填写
LLM_API_KEY=
# 接口地址:官方或你的中转渠道,由你填写
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
